<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B4DBE0"
    tools:context=".kaydedilen_sarkilar">

    <!-- Üstteki Başlık -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical|center_horizontal"
        android:background="#327F87"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#327F87"
            android:drawablePadding="10dp"
            android:shadowColor="#000000"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="2"
            android:text="SES ANALİZİ"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Geri Butonu -->
    <ImageButton
        android:id="@+id/back1Button5"
        android:layout_width="54dp"
        android:layout_height="50dp"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:backgroundTint="#00000000"
        app:srcCompat="@drawable/back_to" />

    <!-- Ses Seviyesi Gösterge Çubuğu -->
    <ProgressBar
        android:id="@+id/volumeProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="160dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:max="100"
        android:progress="50" />

    <!-- Frekans Metni -->
    <TextView
        android:id="@+id/frequencyTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="370dp"
        android:layout_marginTop="110dp"
        android:text="Frequency: 0 Hz"
        android:textColor="#000"
        android:textSize="24sp" />

    <!-- Ses Dosyası Seçme Butonu -->
    <ImageButton
        android:id="@+id/selectFileButton"
        android:layout_width="54dp"
        android:layout_height="50dp"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:backgroundTint="#00000000"
        app:srcCompat="@drawable/ic_file_select"
        android:contentDescription="@string/select_file" />

    <!-- Analiz Başlatma Butonu -->
    <Button
        android:id="@+id/startAnalysisButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="110dp"
        android:backgroundTint="#66B6BF"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="Start Analysis"
        android:textColor="#000000"
        android:textSize="18sp" />

    <!-- Frekansları Kaydırılabilir Listede Göster -->
    <ScrollView
        android:id="@+id/frequencyScrollView"
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:background="#90B4B7"
        android:layout_marginTop="250dp">

        <TextView
            android:id="@+id/frequencyListTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:lineSpacingExtra="5dp"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textColor="#000"
            android:textSize="16sp" />
    </ScrollView>

</FrameLayout>
