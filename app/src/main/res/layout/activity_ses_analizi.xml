<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B4DBE0"
    tools:context=".kaydedilen_sarkilar">

    <!-- Üstteki Başlık -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical|center_horizontal"
        android:background="#327F87"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#327F87"
            android:drawablePadding="10dp"
            android:shadowColor="#000000"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="2"
            android:text="SES ANALİZİ"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Geri Butonu -->
    <ImageButton
        android:id="@+id/back1Button5"
        android:layout_width="54dp"
        android:layout_height="50dp"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:backgroundTint="#00000000"
        app:srcCompat="@drawable/back_to" />

    <!-- Ses Seviyesi Gösterge Çubuğu -->
    <ProgressBar
        android:id="@+id/volumeProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="200dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:max="100"
        android:progress="50" />



    <!-- Frekans Metni -->
    <TextView
        android:id="@+id/frequencyTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_marginStart="370dp"
        android:text="Frequency: 0 Hz"
        android:textColor="#000"
        android:textSize="24sp" />

</FrameLayout>
